HOST=127.0.0.1
PORT=3001
# Run npm run local:setup at the root to configure the local development DB.
# LOCAL_DB_PATH=/absolute/path/to/hyundai/.local/database
# Supabase placeholders for a future hosted adapter (not connected by this implementation).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Dedicated Kakao REST API key. Set only after disabling paid API usage in Kakao.
# Unset keeps route estimates disabled. The server makes at most 5 calls per search.
KAKAO_FREE_ROUTING_KEY=
