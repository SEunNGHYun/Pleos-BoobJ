{
  "name": "@babmatj/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "local:setup": "node --env-file-if-exists=.env scripts/local-setup.mjs",
    "local:seed": "node --env-file-if-exists=.env scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@babmatj/contracts": "0.1.0",
    "@electric-sql/pglite": "0.5.15",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
